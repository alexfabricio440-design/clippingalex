# Copia este archivo a .env y completa. NUNCA subas .env a GitHub.
GROQ_API_KEY=pon_tu_clave_de_groq_aqui

# Recomendado si la app queda accesible desde internet: un codigo que pedira al abrir
APP_TOKEN=

# Opcionales
